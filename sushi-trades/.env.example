# Copy this file to .env.local and fill it in. Never commit .env.local.

# ── The app ────────────────────────────────────────────────────────────────
# Any long random string. The bot must send the same one, so strangers can't post fake trades.
DISCORD_INGEST_SECRET=

# Where "Join" on the Live card goes, e.g. your Discord invite link.
NEXT_PUBLIC_DISCORD_INVITE_URL=

# Set to false to hide the demo traders once real ones are flowing in.
NEXT_PUBLIC_DEMO_DATA=true

# Optional: where Discord data is saved (defaults to ./.data).
# SUSHI_DATA_DIR=

# ── The Discord bot (npm run bot) ─────────────────────────────────────────
# From discord.com/developers/applications → your app → Bot → Reset Token.
DISCORD_BOT_TOKEN=

# Channel IDs to watch, comma-separated. Empty = every channel the bot can see.
# (Discord: Settings → Advanced → Developer Mode, then right-click a channel → Copy Channel ID.)
DISCORD_CHANNEL_IDS=

# Where the Sushi app is running.
SUSHI_URL=http://localhost:3000
