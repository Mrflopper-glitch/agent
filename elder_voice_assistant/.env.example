# ---- Meta WhatsApp Cloud API (developers.facebook.com > your app > WhatsApp > API Setup)
# Access token. The one on the API Setup page expires after ~24h; see README for a permanent one.
WHATSAPP_TOKEN=
# "Phone number ID" of the test number (NOT the phone number itself)
WHATSAPP_PHONE_NUMBER_ID=
# App settings > Basic > App secret. Used to verify webhook signatures.
WHATSAPP_APP_SECRET=
# Any string you make up; type the same string into Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=
# Graph API version. Check the current one in Meta's docs if calls fail.
WHATSAPP_API_VERSION=v23.0

# ---- Gemini (aistudio.google.com > Get API key)
GEMINI_API_KEY=
# Must be a model that accepts audio and is on the free tier for your account.
GEMINI_MODEL=gemini-2.5-flash

# ---- Text-to-speech
# Default provider for all languages: gtts or edge
TTS_PROVIDER=gtts
# Optional per-language overrides (leave empty to use TTS_PROVIDER)
TTS_PROVIDER_TA=
TTS_PROVIDER_HI=
TTS_PROVIDER_TE=
TTS_PROVIDER_EN=
# Convert speech to OGG/Opus with ffmpeg so it plays like a voice note (true/false).
# If ffmpeg is not installed, MP3 is sent instead.
CONVERT_TO_OGG=true

# ---- People and behaviour
CONTACTS_FILE=contacts.json
TIMEZONE=Asia/Kolkata
# Below this AI confidence (0-1) the elder is asked to repeat.
CONFIDENCE_THRESHOLD=0.6
# How many unclear yes/no answers before handing over to the family.
MAX_UNCLEAR_REPLIES=2

# ---- Storage and server
DB_PATH=data/assistant.db
AUDIO_DIR=data/audio
PORT=5000
